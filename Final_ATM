def print_atm_matrix():
    print("\n*************** ATM Availability ***************")
    num_cols = max(len(row) for row in atm_matrix)
    header = "      " + "".join(f"C{c:<3}" for c in range(num_cols))
    print(header)
    for r, row in enumerate(atm_matrix):
        line = f"Row {r} "
        for c in range(num_cols):
            if c < len(row):
                line += f" {row[c]:<3}"
            else:
                line += "  -  "
        print(line)
    available = sum(cell for row in atm_matrix for cell in row)
    total = sum(len(row) for row in atm_matrix)
    print(f"\nAvailable ATMs: {available}")
    print(f"Out of service: {total - available}")


def update_atm_status():
    print_atm_matrix()
    try:
        row = int(input("Update ATM? row= ").strip())
        col = int(input("col= ").strip())
        status = int(input("new status (1=available, 0=out of service)= ").strip())
    except ValueError:
        print("Row, column and status must be numbers.")
        return
    if row < 0 or row >= len(atm_matrix) or col < 0 or col >= len(atm_matrix[row]):
        print("Invalid row/column for the current matrix shape.")
        return
    if status not in (0, 1):
        print("Status must be 0 or 1.")
        return
    atm_matrix[row][col] = status
    print(f"ATM at row={row}, col={col} updated to status={status}.")


def duplicate_check_report():
    seen_phones = {}
    seen_emails = {}
    dup_phones = set()
    dup_emails = set()
    for u in user_data:
        phone = u["profile"]["phone"]
        email = u["profile"]["email"]
        if phone in seen_phones:
            dup_phones.add(phone)
        seen_phones[phone] = seen_phones.get(phone, 0) + 1
        if email in seen_emails:
            dup_emails.add(email)
        seen_emails[email] = seen_emails.get(email, 0) + 1
    print("\n--- Duplicate Detection ---")
    print(f"Duplicate phone numbers: {dup_phones if dup_phones else 'None'}")
    print(f"Duplicate emails: {dup_emails if dup_emails else 'None'}")


def transaction_frequency_report():
    frequency = defaultdict(int)
    for u in user_data:
        for t in u["transactions"]:
            frequency[t["type"]] += 1
    print("\n--- Transaction Frequency Report ---")
    if not frequency:
        print("No transactions recorded yet.")
        return
    for tx_type, count in frequency.items():
        print(f"  {tx_type}: {count}")


